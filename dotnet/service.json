{
  "stack": "dotnet",
  "memory": 512,
  "timeout": 60,
  "ttl": 60,
  "runtimeArgs": [
  ],
  "routes": {
    "ExportAllLists": {
      "path": "/_v/wishlist/export-lists",
      "public": false,
      "policies": [
        {
          "effect": "allow",
          "actions": ["get"]
        }
      ]
    }
  },
  "events": {
    "onAppsLinked": {
      "sender": "apps",
      "keys": ["linked"]
    }
  }
}
