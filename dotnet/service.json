{
  "stack": "dotnet",
  "cpu": {
    "type": "shared",
    "value": 25,
    "scalingPercentage": 95
  },
  "memory": 2048,
  "timeout": 60,
  "ttl": 60,
  "maxReplicas": 100,
  "runtimeArgs": [
  ],
  "routes": {
    "ExportAllLists": {
      "path": "/_v/wishlist/export-lists",
      "public": false,
      "policies": [
        {
          "effect": "allow",
          "actions": ["get"]
        }
      ]
    }
  },
  "events": {
    "onAppsLinked": {
      "sender": "apps",
      "keys": ["linked"]
    }
  }
}
